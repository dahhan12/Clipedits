{
  "name": "campaignclipper",
  "version": "0.1.0",
  "private": true,
  "description": "Discover Content Rewards campaigns, extract validated rules, generate compliant short-form video drafts, and track submissions.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "eval": "tsx scripts/eval.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "seed:admin": "tsx scripts/seed-admin.ts",
    "worker:discovery": "tsx src/workers/discovery.worker.ts",
    "worker:pipeline": "tsx src/workers/pipeline.worker.ts",
    "worker:render": "tsx src/workers/render.worker.ts",
    "worker:publish": "tsx src/workers/publish.worker.ts",
    "worker:submission": "tsx src/workers/submission.worker.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@aws-sdk/client-s3": "^3.717.0",
    "@aws-sdk/s3-request-presigner": "^3.1091.0",
    "@prisma/client": "^6.1.0",
    "@remotion/bundler": "^4.0.495",
    "@remotion/renderer": "^4.0.495",
    "bullmq": "^5.34.0",
    "ioredis": "^5.4.2",
    "next": "^15.1.3",
    "pino": "^9.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "^4.0.495",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.3",
    "playwright": "^1.49.1",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
