// CampaignClipper Prisma schema.
// All external/model-derived structured data is validated by Zod before it
// lands here. Every entity that a retried job could touch has a deterministic
// unique key so work is never performed twice.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum CampaignSource {
  CONTENT_REWARDS
  WHOP_FORUM
  MANUAL
}

enum CampaignStatus {
  DISCOVERED
  PARSING
  PARSED
  NEEDS_MANUAL_REVIEW
  ACTIVE
  PAUSED
  CLOSED
  ERROR
}

enum RuleStatus {
  PARSED
  NEEDS_MANUAL_REVIEW
}

enum ResourceKind {
  DIRECT_VIDEO
  GOOGLE_DRIVE_FILE
  GOOGLE_DRIVE_FOLDER
  DROPBOX_FILE
  DROPBOX_FOLDER
  YOUTUBE
  DOCUMENT
  OTHER
}

enum ResourceStatus {
  DISCOVERED
  APPROVED
  REJECTED
  DOWNLOADED
  FAILED
}

enum AssetStatus {
  PENDING
  DOWNLOADING
  READY
  FAILED
}

enum ClipStatus {
  CANDIDATE
  REJECTED
  APPROVED
  RENDERING
  RENDERED
  FAILED
}

enum Platform {
  TIKTOK
  INSTAGRAM_REELS
  YOUTUBE_SHORTS
}

enum ComplianceOutcome {
  PASS
  FAIL
  REVIEW
}

enum PublicationMode {
  AUTO
  DRAFT
  MANUAL
}

enum PublicationStatus {
  PENDING
  DRAFTED
  PUBLISHED
  FAILED
  SKIPPED
}

enum SubmissionStatus {
  PREPARED
  AWAITING_CONFIRMATION
  SUBMITTED
  APPROVED
  REJECTED
  FAILED
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
}

enum PayoutStatus {
  NONE
  PENDING
  PROCESSING
  PAID
}

enum PermissionStatus {
  UNVERIFIED   // auto-derived from campaign text; not human-confirmed
  PROVISIONAL  // derived and plausible, still needs review before public use
  VERIFIED     // a human confirmed the rights evidence
  REVOKED
  DENIED
}

enum TransformationType {
  DOWNLOAD
  CLIP
  MODIFY
  CAPTION
  OVERLAY
  PUBLISH
}

enum Role {
  ADMIN
  OPERATOR
  VIEWER
}

// ---------------------------------------------------------------------------
// Tenancy & auth
// ---------------------------------------------------------------------------

model Workspace {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  users User[]
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String?
  role         Role       @default(VIEWER)
  // scrypt hash (salt embedded); never stored or logged in plaintext.
  passwordHash String?
  workspace    Workspace? @relation(fields: [workspaceId], references: [id])
  workspaceId  String?
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([workspaceId])
}

// ---------------------------------------------------------------------------
// Campaign core
// ---------------------------------------------------------------------------

model Campaign {
  id           String         @id @default(cuid())
  source       CampaignSource
  externalId   String
  title        String?
  sourceUrl    String
  status       CampaignStatus @default(DISCOVERED)
  // Optimistic-concurrency version; bumped on every guarded state transition.
  version      Int            @default(0)
  // Latest observed page hash (drift detection lives on CampaignRevision).
  lastPageHash String?
  discoveredAt DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  revisions   CampaignRevision[]
  rules       CampaignRule[]
  resources   CampaignResource[]
  sourceAssets SourceAsset[]
  submissions CampaignSubmission[]

  @@unique([source, externalId])
  @@index([status])
}

model CampaignRevision {
  id         String   @id @default(cuid())
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId String
  // Stable hash of the normalized campaign page used to detect revisions.
  pageHash   String
  // Raw captured snapshot (HTML/text) kept for auditing extractions.
  rawSnapshot String?
  budgetTotal     Float?
  budgetRemaining Float?
  status          String?
  capturedAt DateTime @default(now())

  @@unique([campaignId, pageHash])
  @@index([campaignId, capturedAt])
}

model CampaignRule {
  id         String     @id @default(cuid())
  campaign   Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId String
  status     RuleStatus @default(PARSED)
  // The Zod-validated CampaignRules payload.
  rules      Json
  confidence Float
  // Fields the model flagged as uncertain/contradictory.
  uncertainties Json?
  model      String?
  createdAt  DateTime   @default(now())

  compliance ComplianceResult[]

  @@index([campaignId, createdAt])
}

model CampaignResource {
  id         String         @id @default(cuid())
  campaign   Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId String
  kind       ResourceKind
  url        String
  status     ResourceStatus @default(DISCOVERED)
  // Whether the campaign expressly permits pulling from this source.
  permitted  Boolean        @default(false)
  notes      String?
  createdAt  DateTime       @default(now())

  sourceAssets SourceAsset[]

  @@unique([campaignId, url])
}

// ---------------------------------------------------------------------------
// Assets & clips
// ---------------------------------------------------------------------------

model SourceAsset {
  id           String            @id @default(cuid())
  campaign     Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId   String
  resource     CampaignResource? @relation(fields: [resourceId], references: [id])
  resourceId   String?
  // Original source URL/identifier the asset was pulled from.
  originalSource String
  storageKey   String?
  checksum     String
  mimeType     String?
  bytes        Int?
  durationSec  Float?
  status       AssetStatus       @default(PENDING)
  downloadedAt DateTime?
  createdAt    DateTime          @default(now())

  transcript Json?
  candidates ClipCandidate[]
  permissions AssetPermission[]

  @@unique([campaignId, checksum])
  @@index([status])
}

model ClipCandidate {
  id           String     @id @default(cuid())
  sourceAsset  SourceAsset @relation(fields: [sourceAssetId], references: [id], onDelete: Cascade)
  sourceAssetId String
  startSec     Float
  endSec       Float
  // Version of the scoring/generation logic; part of the idempotency key so a
  // re-run with the same logic + range does not create a duplicate candidate.
  scoringVersion Int      @default(1)
  status       ClipStatus @default(CANDIDATE)
  version      Int        @default(0)
  rejectionReason String?
  // Claude scores: hook, clarity, emotional intensity, relevance, standalone.
  scores       Json?
  createdAt    DateTime   @default(now())

  rendered RenderedClip[]

  @@unique([sourceAssetId, startSec, endSec, scoringVersion])
  @@index([sourceAssetId, status])
}

model RenderedClip {
  id            String     @id @default(cuid())
  candidate     ClipCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  candidateId   String
  // Hash of the render configuration (range + frame size + overlays + backend +
  // audio options). Unique per candidate so an identical re-render is idempotent.
  renderConfigHash String  @default("")
  storageKey    String?
  thumbnailKey  String?
  width         Int?
  height        Int?
  durationSec   Float?
  bytes         Int?
  videoCodec    String?    @default("h264")
  audioCodec    String?    @default("aac")
  perceptualHash String?
  audioHash     String?
  version       Int        @default(0)
  // Full description of every transformation applied.
  renderManifest Json?
  createdAt     DateTime   @default(now())

  compliance   ComplianceResult[]
  publications Publication[]

  @@unique([candidateId, renderConfigHash])
  @@index([candidateId])
}

// ---------------------------------------------------------------------------
// Compliance
// ---------------------------------------------------------------------------

model ComplianceResult {
  id           String            @id @default(cuid())
  renderedClip RenderedClip      @relation(fields: [renderedClipId], references: [id], onDelete: Cascade)
  renderedClipId String
  rule         CampaignRule?     @relation(fields: [ruleId], references: [id])
  ruleId       String?
  check        String
  outcome      ComplianceOutcome
  reason       String
  deterministic Boolean          @default(true)
  createdAt    DateTime          @default(now())

  @@index([renderedClipId, outcome])
}

// ---------------------------------------------------------------------------
// Publishing & submission
// ---------------------------------------------------------------------------

model SocialAccount {
  id            String   @id @default(cuid())
  platform      Platform
  handle        String
  externalId    String?
  // AES-256-GCM encrypted OAuth refresh token. Never stored in plaintext.
  encryptedRefreshToken String?
  scopes        String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  publications Publication[]

  @@unique([platform, handle])
}

model Publication {
  id             String            @id @default(cuid())
  renderedClip   RenderedClip      @relation(fields: [renderedClipId], references: [id], onDelete: Cascade)
  renderedClipId String
  account        SocialAccount?    @relation(fields: [accountId], references: [id])
  accountId      String?
  platform       Platform
  mode           PublicationMode
  status         PublicationStatus @default(PENDING)
  version        Int               @default(0)
  // Deterministic key to make publish jobs idempotent.
  idempotencyKey String
  postUrl        String?
  externalPostId String?
  publicVerified Boolean           @default(false)
  captionText    String?
  failureReason  String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  submission CampaignSubmission?
  metrics    PostMetric[]

  @@unique([renderedClipId, platform, idempotencyKey])
  @@index([status])
}

model CampaignSubmission {
  id            String           @id @default(cuid())
  campaign      Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId    String
  publication   Publication      @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  publicationId String           @unique
  status        SubmissionStatus @default(PREPARED)
  version       Int              @default(0)
  submittedAt   DateTime?
  approvalState String?
  rejectionReason String?
  qualifiedViews Int?
  estimatedEarnings Float?
  confirmedEarnings Float?
  payoutStatus  PayoutStatus     @default(NONE)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  earnings EarningsRecord[]

  @@unique([campaignId, publicationId])
  @@index([status])
}

// A point-in-time snapshot of a published post's platform metrics.
model PostMetric {
  id            String      @id @default(cuid())
  publication   Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  publicationId String
  views         Int?
  likes         Int?
  comments      Int?
  shares        Int?
  qualifiedViews Int?
  // Provider-reported capture time (day granularity when the API gives no
  // timestamp). Unique per publication so a re-poll for the same window is
  // idempotent rather than inserting a duplicate snapshot.
  providerCapturedAt DateTime @default(now())
  capturedAt    DateTime    @default(now())

  @@unique([publicationId, providerCapturedAt])
  @@index([publicationId, capturedAt])
}

// A point-in-time snapshot of a submission's earnings/payout state.
model EarningsRecord {
  id            String       @id @default(cuid())
  submission    CampaignSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  submissionId  String
  qualifiedViews Int?
  estimatedEarnings Float?
  confirmedEarnings Float?
  payoutStatus  PayoutStatus @default(NONE)
  recordedAt    DateTime     @default(now())

  @@index([submissionId, recordedAt])
}

// ---------------------------------------------------------------------------
// Rights & provenance
// ---------------------------------------------------------------------------

// Proves WHY a source asset may be used, tied to the exact campaign revision
// that authorised it. Unknown/unverified permission must never produce a
// compliance PASS.
model AssetPermission {
  id                 String             @id @default(cuid())
  sourceAsset        SourceAsset        @relation(fields: [sourceAssetId], references: [id], onDelete: Cascade)
  sourceAssetId      String
  // The campaign revision (page hash snapshot) that granted the rights.
  campaignRevisionId String?
  permissionType     String             // e.g. "CAMPAIGN_GRANT", "LICENSE", "OWNED"
  permittedPlatforms Platform[]         @default([])
  permittedTransformations TransformationType[] @default([])
  validFrom          DateTime?
  validUntil         DateTime?
  evidenceUrl        String?
  evidenceExcerpt    String?
  evidenceHash       String?
  verifiedByUserId   String?
  verifiedAt         DateTime?
  status             PermissionStatus   @default(UNVERIFIED)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([sourceAssetId, status])
}

// Field-level extraction evidence for a campaign revision.
model RuleEvidence {
  id                 String   @id @default(cuid())
  campaignRevisionId String
  fieldPath          String
  sourceUrl          String?
  sourceType         String   // "DOM" | "DOCUMENT" | "VISION" | "LLM" | "HUMAN"
  excerpt            String?
  screenshotStorageKey String?
  contentHash        String?
  capturedAt         DateTime @default(now())

  @@index([campaignRevisionId, fieldPath])
}

// A captured snapshot of a platform's publishing policy/capabilities.
model PlatformPolicySnapshot {
  id                  String   @id @default(cuid())
  platform            Platform
  policyVersion       String
  capturedAt          DateTime @default(now())
  sourceUrl           String?
  capabilities        String[] @default([])
  restrictions        String[] @default([])
  requiredHumanActions String[] @default([])

  @@index([platform, capturedAt])
}

// ---------------------------------------------------------------------------
// Operations
// ---------------------------------------------------------------------------

model JobRun {
  id        String    @id @default(cuid())
  queue     String
  // Deterministic per-unit-of-work key guaranteeing idempotent processing.
  jobKey    String
  status    JobStatus @default(QUEUED)
  attempts  Int       @default(0)
  error     String?
  payload   Json?
  startedAt DateTime?
  finishedAt DateTime?
  createdAt DateTime  @default(now())

  @@unique([queue, jobKey])
  @@index([status])
}

model AuditEvent {
  id         String   @id @default(cuid())
  actor      String   @default("system")
  role       Role?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}
