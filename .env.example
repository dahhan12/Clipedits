# ---------------------------------------------------------------------------
# CampaignClipper environment configuration
# Copy to .env and fill in. NEVER commit a real .env.
# ---------------------------------------------------------------------------

# --- Core ---
NODE_ENV=development
APP_URL=http://localhost:3000
# 32-byte key (base64) used to encrypt OAuth refresh tokens at rest.
# Generate: openssl rand -base64 32
ENCRYPTION_KEY=
# HMAC secret for signing session cookies (falls back to ENCRYPTION_KEY).
SESSION_SECRET=
# Per-IP request budget per minute for mutating API routes.
RATE_LIMIT_PER_MINUTE=120

# Default admin seeded by `npm run seed:admin` (password printed if unset).
ADMIN_EMAIL=admin@campaignclipper.local
ADMIN_PASSWORD=

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://clipper:clipper@localhost:5432/campaignclipper?schema=public

# --- Redis / BullMQ ---
REDIS_URL=redis://localhost:6379

# --- Anthropic ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Transcription (Whisper-compatible /audio/transcriptions) ---
# When set, word-level Whisper transcription is used; otherwise the sandbox
# transcriber runs.
WHISPER_API_URL=
WHISPER_API_KEY=
WHISPER_MODEL=whisper-1

# --- Cloudflare R2 (S3-compatible) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=campaignclipper
R2_ENDPOINT=

# --- Discovery: Content Rewards ---
CONTENT_REWARDS_BASE_URL=https://www.contentrewards.com
CONTENT_REWARDS_DISCOVER_PATH=/discover

# --- Discovery: Whop Forums ---
# When set, the official Whop Forums API is used; otherwise the Playwright
# fallback with a persistent session is used. Raw passwords are NEVER stored.
WHOP_API_KEY=
WHOP_EXPERIENCE_ID=
WHOP_FORUM_BOT_USERNAME=contentrewardsbot

# --- Playwright ---
# Directory for the persistent authenticated browser context (fallback mode).
PLAYWRIGHT_STATE_DIR=./playwright-state
PLAYWRIGHT_HEADLESS=true

# --- Rendering ---
# "ffmpeg" (default) or "remotion" (composited overlays via a headless browser).
RENDER_BACKEND=ffmpeg
RENDER_WIDTH=1080
RENDER_HEIGHT=1920
# Optional: point Remotion at the pre-installed Chromium instead of downloading.
REMOTION_BROWSER_EXECUTABLE=

# --- Publishing OAuth (client credentials only; user refresh tokens are stored
# AES-256-GCM encrypted in the DB, never in env or logs) ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_AUDITED=false
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_APPROVED=false
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_API_VERIFIED=false

# --- Submission ---
# Require an explicit human confirmation before the final on-site submit (MVP).
SUBMISSION_REQUIRE_CONFIRMATION=true

# --- Security ---
# Comma-separated allowlist of hostnames permitted for resource downloads.
DOWNLOAD_ALLOWED_HOSTS=drive.google.com,docs.google.com,dropbox.com,www.dropbox.com,youtube.com,www.youtube.com
# Max download size in bytes (default 2 GiB).
DOWNLOAD_MAX_BYTES=2147483648
